---
import { getCollection, type CollectionEntry } from 'astro:content'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import { Image } from 'astro:assets'

type Photo = CollectionEntry<'photos'>

const photos: Photo[] = (await getCollection('photos')).sort(
  (a: Photo, b: Photo) => b.data.date.valueOf() - a.data.date.valueOf(),
)
---

<LayoutDefault>
  <div id="gallery">
    {
      photos.map((photo: Photo, index: number) => (
        <div class="photo-item" data-index={index}>
          <div class="photo-wrapper">
            <Image src={photo.data.image} alt={photo.data.title ?? ''} class="photo-img" />
          </div>
          {photo.data.title && <div class="photo-title">{photo.data.title}</div>}
        </div>
      ))
    }
  </div>
</LayoutDefault>

<style>
  #gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .photo-item {
    cursor: pointer;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .photo-item:hover:not(.expanded) {
    transform: scale(1.02);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
  }

  .photo-item.expanded {
    grid-column: 1 / -1;
    width: 100%;
    z-index: 10;
    position: relative;
  }

  .photo-wrapper {
    overflow: hidden;
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transition: box-shadow 0.3s ease;
  }

  .photo-item.expanded .photo-wrapper {
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .photo-img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .photo-item:hover:not(.expanded) .photo-img {
    transform: scale(1.05);
  }

  .photo-item.expanded .photo-img {
    max-height: 90vh;
    width: 100%;
    object-fit: contain;
  }

  .photo-title {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    opacity: 0.7;
    transition: opacity 0.3s ease;
    text-align: left;
  }

  .photo-item.expanded .photo-title {
    text-align: center;
    font-size: 1rem;
    opacity: 0.9;
  }

  /* Smooth grid reflow animation */
  @supports (view-transition-name: none) {
    .photo-item {
      view-transition-name: var(--photo-vt-name);
    }

    ::view-transition-group(*) {
      animation-duration: 0.4s;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
  }
</style>

<script>
  let escHandler: ((e: KeyboardEvent) => void) | null = null

  function initGallery() {
    const gallery = document.getElementById('gallery')
    if (!gallery) {
      return
    }

    // Check if already initialized
    if (gallery.dataset.initialized === 'true') {
      return
    }
    gallery.dataset.initialized = 'true'

    const items = gallery.querySelectorAll('.photo-item') as NodeListOf<HTMLElement>

    // Assign unique view transition names
    items.forEach((item, index) => {
      item.style.setProperty('--photo-vt-name', `photo-${index}`)
    })

    function handleClick(clickedItem: HTMLElement) {
      const wasExpanded = clickedItem.classList.contains('expanded')

      const toggle = () => {
        // Collapse all items first
        items.forEach((item) => item.classList.remove('expanded'))

        // If clicked item wasn't expanded, expand it
        if (!wasExpanded) {
          clickedItem.classList.add('expanded')
        }
      }

      // Use View Transitions API for smooth animation if available
      if (document.startViewTransition) {
        const transition = document.startViewTransition(() => {
          toggle()
        })

        transition.finished.then(() => {
          if (clickedItem.classList.contains('expanded')) {
            clickedItem.scrollIntoView({ behavior: 'smooth', block: 'center' })
          }
        })
        return
      }

      toggle()
      if (clickedItem.classList.contains('expanded')) {
        setTimeout(() => {
          clickedItem.scrollIntoView({ behavior: 'smooth', block: 'center' })
        }, 500)
      }
    }

    // Add click listeners
    items.forEach((item) => {
      item.addEventListener('click', () => handleClick(item))
    })

    // Remove old ESC handler if exists
    if (escHandler) {
      document.removeEventListener('keydown', escHandler)
    }

    // ESC key to collapse
    escHandler = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        items.forEach((item) => item.classList.remove('expanded'))
      }
    }
    document.addEventListener('keydown', escHandler)
  }

  // Initialize on page load
  initGallery()

  // Re-initialize after Swup page transitions
  document.addEventListener('swup:content:replace', () => {
    // Reset initialization flag for new content
    const gallery = document.getElementById('gallery')
    if (gallery) {
      gallery.dataset.initialized = 'false'
    }
    initGallery()
  })
</script>
